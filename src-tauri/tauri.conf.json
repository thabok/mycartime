{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Carpool Planner",
  "version": "0.1.0",
  "identifier": "com.thabok.mycartime",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "Carpool Planner for Teachers",
        "width": 1280,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../backend/dist/app.dist": "backend/"
    }
  }
}
